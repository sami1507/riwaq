# Reference only. Set variables in the launching process; no automatic .env loading.
# Batch03: local document/data operations additionally require a reviewed
# RIWAQ_DATA_DIR/isolated-workers.json with the pinned skill_transform image.
# No API key or host-parser fallback. See docs/skills/SKILLS_BATCH_03_REPORT.md.
RIWAQ_DATA_DIR=./data
RIWAQ_SYNC_URL=http://127.0.0.1:8766
RIWAQ_VISION_MODEL=qwen3-vl:2b-instruct
RIWAQ_EMBED_MODEL=embeddinggemma-2:270m-q8_0-text
# RIWAQ_WHISPER_MODEL=<absolute local faster-whisper directory>
# API keys: scripts/set-key.py stores them in OS keyring, never here.

# Guard v1: start the service, then explicitly pair this browser using
# .\scripts\pair-browser.ps1 -Copy (same RIWAQ_DATA_DIR as the service).
# No shared browser/API secret belongs in this file. DPAPI owner key is private.
# Dev origin 5173 is untrusted by default. Only for intentional local development:
# RIWAQ_DEV_ORIGIN=1
# Cloud generation and new personal-preference memory writes are quarantined.
# Hybrid mode alone cannot lift these gates. No env flag bypass is supplied.
# See docs/RIWAQ_GUARD.md and docs/RIWAQ_SECURITY_ACCEPTANCE.md.

# Local image studio; setup is explicit, never downloaded on app startup.
RIWAQ_VISUAL_PYTHON=D:/RiwaqRuntime/visual-v1/venv/Scripts/python.exe
RIWAQ_IMAGE_MODEL_DIR=D:/RiwaqRuntime/visual-v1/sd15

# Local document processing; setup is explicit. No automatic model downloads.
RIWAQ_DOCUMENT_RUNTIME=D:/RiwaqRuntime/documents-v1
# Optional JSON file that may LOWER the validated extraction ceilings:
# RIWAQ_DOCUMENT_LIMITS=C:/path/to/document-limits.json

# Video composition uses the existing local PyAV/FFmpeg libraries, Node, Chrome,
# Playwright and bundled licensed fonts. No video-generation or Arabic TTS
# provider is configured, and no API key or automatic download is required.
# Validated ceilings live in backend/video_schema.py and docs/VIDEO.md.

# Voice sessions reuse RIWAQ_WHISPER_MODEL and the explicitly selected local
# Ollama chat model. No API key, new voice download or cloud fallback.
# Local Windows PowerShell 5/System.Speech discovers installed matching voices.
# Audio/text are transient until explicit text Save; raw recordings are not saved.
# Speech capture needs a secure browser context (localhost is supported).
# Limits, supported formats and untested languages: docs/RIWAQ_VOICE.md.

# Coding assistant uses the locally selected Ollama model and the existing SQLite.
# No new API key, host shell, model download, or sandbox enablement variable.
# Bounded Python/Node copies can now run in the verified local Docker adapter.
# Server-owned RIWAQ_DATA_DIR/isolated-workers.json pins CLI/daemon/image IDs;
# it is not a project/model setting. No auto-pull, host fallback or dependency install.
# Missing/invalid runtime configuration fails closed. A zero exit is not proof of
# test coverage; tests_passed remains null. See docs/CODING_SANDBOX.md.
# Historical Stage 6 evidence predates the actual Docker discovery and live checks.

# Research reuses RIWAQ_EMBED_MODEL, the approved knowledge/sources.json registry,
# the existing SQLite corpus, and the selected local Ollama generation model.
# Live catalogue reading requires hybrid mode AND per-request allow_network=true.
# It is not general web search. No automatic fetch, provider fallback, or training.
# Brave keys (optional legacy search snippets) belong only in the OS keyring via
# scripts/set-key.py; snippets are not read pages. See docs/RIWAQ_RESEARCH_KNOWLEDGE.md.

# Skill batch01 reuses the current SQLite, local owner session and Ollama model.
# No new key or service is required. The trusted catalogue is config/skills-batch-01.json;
# packages under skills/ are bundled application data, not executable plugins.
# No environment flag lifts the personal-memory security gate.
# Optional acceptance flags belong only in the test shell, never production:
# RIWAQ_TEST_LIVE_SKILLS=1 (real local model; see docs/skills/SKILLS_BATCH_01_ACCEPTANCE.md).

# Batch04 uses the existing SQLite and local session; tzdata==2026.6 supplies IANA
# rules on Windows. The in-app reminder worker runs while the Riwaq service runs.
# No OS startup service, device-push service or external calendar is installed.
# Optional SMTP is operator-configured at RIWAQ_DATA_DIR/mail-accounts.json;
# no hostname, credential or recipient policy is accepted from model text.
# Store a credential interactively with scripts/set-key.py mail --account-id ID.
# Never put passwords in this file or in chat. Imported mail/drafts work offline.
# SMTP also needs the existing hybrid mode plus a reviewed exact-draft send.
# See docs/skills/SKILLS_BATCH_04_SPEC.md and SKILLS_BATCH_04_REPORT.md for scope.

# Batch05: read-only audit (names/status only):
# .venv/Scripts/python.exe scripts/audit_environment.py
# Existing optional server overrides; unset keeps the implemented default.
# RIWAQ_STATIC_DIR=<built frontend directory>
# RIWAQ_DOCUMENT_NODE=<existing node executable>
# RIWAQ_KNOWLEDGE_REGISTRY=<reviewed source registry JSON>
# RIWAQ_GROUNDED_POLICY=legacy-v1
# RIWAQ_REASONING_VARIANT=tools
# RIWAQ_TOOL_CONTEXT_VERSION=semantic-v2
# RIWAQ_MEDIA_VALIDATION_REPORT=<local validation report path>
# RIWAQ_SYNC_DATA_DIR=<separate optional sync-service data directory>
# RIWAQ_SYNC_ALLOWED_HOSTS=<explicit sync-service host list>
# RIWAQ_SYNC_ALLOWED_ORIGINS=<explicit sync-service origins>
# RIWAQ_SYNC_SESSION_SECONDS=86400
# RIWAQ_PACKAGED_MEDIA_WORKER is internal packaging state, not an enable switch.
# RIWAQ_TEST_* and *_TEST_RUN belong only in test shells; the fixed CI profile
# removes them before execution. No new production environment variable,
# provider secret, cloud bypass or notification channel is introduced.
