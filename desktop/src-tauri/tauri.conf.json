{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riwaq",
  "version": "0.1.0",
  "identifier": "app.riwaq.local",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/riwaq-service"],
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper"},
      "nsis": {"displayLanguageSelector": false, "installMode": "currentUser"}
    },
    "shortDescription": "A private workspace for thinking and building",
    "longDescription": "Riwaq runs a local AI assistant with project sources, editable memory and a visible work history. Ollama and model weights are installed separately."
  }
}
