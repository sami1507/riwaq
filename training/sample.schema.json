{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "source_group", "license", "training_permission", "permission_reference", "redaction_reviewed", "messages"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source_group": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "training_permission": {"const": true},
    "permission_reference": {"type": "string", "minLength": 1},
    "redaction_reviewed": {"const": true},
    "messages": {
      "type": "array", "minItems": 2,
      "items": {"type": "object", "required": ["role", "content"], "properties": {"role": {"enum": ["system", "user", "assistant"]}, "content": {"type": "string", "minLength": 1}}}
    }
  }
}
